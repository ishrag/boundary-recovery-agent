# Laptop demo binding. Keep this on localhost unless a proxy protects it.
BOUNDARY_BIND=127.0.0.1
BOUNDARY_PORT=8000

# Used when the two services run outside Docker.
BOUNDARY_DB_PATH=boundary.db
BOUNDARY_PROVIDER_DB_PATH=provider.db
BOUNDARY_PROVIDER_URL=http://127.0.0.1:8001
BOUNDARY_PROVIDER_TIMEOUT=2.0

